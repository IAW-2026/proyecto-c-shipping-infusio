generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DeliveryAssignment {
  id                 String  @id
  shipmentId         String
  riderId            String?
  logisticOperatorId String?

  LogisticOperator   LogisticOperator? @relation(fields: [logisticOperatorId], references: [id], onDelete: SetNull)
  Rider              Rider?            @relation(fields: [riderId], references: [id], onDelete: SetNull)
  Shipment           Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
}

model LogisticOperator {
  id        String    @id
  userId    String?   @unique
  name      String
  email     String    @unique
  active    Boolean   @default(true)
  deletedAt DateTime?

  User      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  DeliveryAssignment DeliveryAssignment[]
}

model Rider {
  id        String      @id
  userId    String?     @unique
  name      String
  email     String      @unique
  status    RiderStatus @default(activo)
  location  String
  active    Boolean     @default(true)
  deletedAt DateTime?

  User      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  DeliveryAssignment DeliveryAssignment[]
}

model Shipment {
  id                  String   @id
  origin              String
  destination         String
  originDatetime      DateTime
  destinationDatetime DateTime
  buyerId             String
  sellerId            String
  active              Boolean  @default(true)
  deletedAt           DateTime?

  DeliveryAssignment  DeliveryAssignment[]
  Tracking            Tracking[]
}

model Tracking {
  shipmentId  String
  datetime    DateTime
  status      TimelineStatuses
  currentCity String
  nextCity    String
  completed   Boolean  @default(false)
  current     Boolean  @default(false)
  active      Boolean  @default(true)
  deletedAt   DateTime?

  Shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@id([shipmentId, datetime])
}

model User {
  id        String    @id
  name      String
  surname   String
  email     String    @unique
  pushSub   Boolean   @default(false)
  emailSub  Boolean   @default(false)
  active    Boolean   @default(true)
  deletedAt DateTime?

  UserRole  UserRole[]
  Rider     Rider?
  LogisticOperator LogisticOperator?
  PushSubscription PushSubscription?
}

model PushSubscription {
  userId       String   @id
  subscription Json
  createdAt    DateTime @default(now())

  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRole {
  userId String
  role   UserRoleType

  User   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

enum RiderStatus {
  activo
  inactivo
}

enum UserRoleType {
  rider
  logistic_operator
  admin
  buyer
  seller
  shipping_admin
  viewer
}

enum TimelineStatuses {
  CONFIRMED
  PREPARING
  IN_TRANSIT
  ARRIVED_CITY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  WITH_ISSUE
}